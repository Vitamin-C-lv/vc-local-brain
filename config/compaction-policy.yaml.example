# Apply these policies only to the exact Local Brain routes.
- id: compaction-basic
  name: '@deepseek-ai/dsh-compaction-basic'
  disabled: false
  config:
    auto: false
    thresholdRatio: 0.8
    retainRatio: 0.16
    maxTokens: 8192
    modelPolicies:
      - provider: local-brain
        model: local-brain-v1
        thresholdRatio: 0.68
        retainRatio: 0.15
        maxTokens: 8192
      - provider: local-qwen
        model: li-huahua-local
        thresholdRatio: 0.68
        retainRatio: 0.15
        maxTokens: 8192
